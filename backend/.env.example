# Copy this file to .env. Never commit .env.
APP_ENV=development
FRONTEND_ORIGINS=http://localhost:3000,http://localhost:5173
# Use the Supabase project URL, not the /rest/v1/ endpoint.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
OPENWEATHER_API_KEY=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=MeghVaani/0.1 (local development)
TWEETHARVEST_API_URL=
TWEETHARVEST_API_KEY=
TWEETHARVEST_BEARER_TOKEN=
# Required for citizen/admin JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5/weather
OPENWEATHER_POLL_INTERVAL_SECONDS=900
ADMIN_USERNAME=admin@example.com
# pbkdf2_sha256$iterations$base64url-salt$base64url-hash
ADMIN_PASSWORD_HASH=
